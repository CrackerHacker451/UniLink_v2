<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Professional Typography System -->
    <style name="TextHeading" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextSubheading" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">?attr/textSecondaryColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="CardView.Professional" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/cardBackgroundColor</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/borderStrokeColor</item>
    </style>

    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="AppTabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorColor">?attr/accentColor</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabSelectedTextColor">?attr/accentColor</item>
        <item name="tabTextColor">?attr/textSecondaryColor</item>
        <item name="tabTextAppearance">@style/AppTabTextAppearance</item>
        <item name="tabGravity">fill</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="AppTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NeonSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">?attr/accentColor</item>
        <item name="trackTint">?attr/textSecondaryColor</item>
    </style>

    <style name="ReactionEmoji">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">26sp</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/btn_press_scale</item>
    </style>

    <style name="ChipTag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:textColor">?attr/tagTextColor</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
