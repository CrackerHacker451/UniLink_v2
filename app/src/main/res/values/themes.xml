        <item name="android:textColorPrimaryDisableOnly">?attr/textPrimaryColor</item>
        <item name="colorSurface">?attr/cardBackgroundColor</item>
        <item name="colorOnSurface">?attr/textPrimaryColor</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

