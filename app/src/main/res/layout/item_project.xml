<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardView.Professional"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/borderStrokeColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Row with Badges -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSourceBadge"
                    style="@style/ChipTag"
                    android:layout_marginEnd="6dp"
                    android:text="🌐 Web"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvProjectStatus"
                    style="@style/ChipTag"
                    android:text="Open"
                    android:backgroundTint="#1A22C55E"
                    android:textColor="#22C55E"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/layoutBadges"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                style="@style/TextHeading"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Autonomous AI Campus Research Assistant" />

        </RelativeLayout>

        <!-- Project Description -->
        <TextView
            android:id="@+id/tvProjectDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/TextBody"
            android:maxLines="3"
            android:ellipsize="end"
            android:textSize="13sp"
            tools:text="Building an on-device local RAG system using LiteRT and Gemini Nano to assist university students with research queries." />

        <!-- Required Skills Stacks -->
        <TextView
            android:id="@+id/tvProjectSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="KOTLIN • JETPACK COMPOSE • LITERT"
            android:textColor="?attr/accentColor"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <!-- Progress & Team Capacity Meter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextSubheading"
                        android:textSize="11sp"
                        android:text="Milestone Progress" />
                    <TextView
                        android:id="@+id/tvProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        style="@style/TextHeading"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="75%" />
                </RelativeLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/projectProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:indicatorColor="?attr/accentColor"
                    app:trackColor="?attr/tagBackgroundColor"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="8dp"
                    android:progress="75" />
            </LinearLayout>

            <!-- Team Slot Counter Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/tagBackgroundColor"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvTeamCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextHeading"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="3/4" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextSubheading"
                    android:textSize="9sp"
                    android:text="TEAM SLOTS" />
            </LinearLayout>

        </LinearLayout>

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="Join Project"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
