<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardView.Professional"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSourceBadge"
                    style="@style/ChipTag"
                    android:layout_marginEnd="8dp"
                    android:text="🌐 Web"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvProjectStatus"
                    style="@style/ChipTag"
                    android:text="Open"
                    android:backgroundTint="#1A22C55E"
                    android:textColor="#22C55E" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/layoutBadges"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                style="@style/TextHeading"
                android:textSize="18sp"
                tools:text="Project Title" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvProjectDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/TextBody"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Professional project description with better spacing and typography." />

        <TextView
            android:id="@+id/tvProjectSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kotlin • Firebase • AI"
            android:textColor="?attr/accentColor"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05" />

        <!-- Progress & Team Meter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextSubheading"
                    android:textSize="11sp"
                    android:text="Progress: 60%" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/projectProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:indicatorColor="?attr/accentColor"
                    app:trackColor="?attr/tagBackgroundColor"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    android:progress="60" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvTeamCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextHeading"
                    android:textSize="16sp"
                    tools:text="3/4" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextSubheading"
                    android:textSize="10sp"
                    android:text="Team Fill" />
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            style="@style/PrimaryButton"
            android:layout_marginTop="20dp"
            android:text="Join Project" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
