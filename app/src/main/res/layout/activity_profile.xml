<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appBackgroundColor">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Premium Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp">

                    <ImageView
                        android:id="@+id/ivProfileBanner"
                        android:layout_width="336dp"
                        android:layout_height="0dp"
                        android:contentDescription="Profile Banner"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_animated_mesh" />

                    <View
                        android:layout_width="378dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_gradient_transparent_dark" />

                    <ImageView
                        android:id="@+id/btnSettings"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="16dp"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="@color/white"
                        android:background="@drawable/bg_glass"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Settings" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfileLarge"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="?attr/appBackgroundColor"
                        app:strokeWidth="4dp"
                        android:elevation="6dp"
                        android:contentDescription="Profile Avatar" />
                </RelativeLayout>

                <!-- Basic Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.01"
                            tools:text="Student Name" />

                        <ImageView
                            android:id="@+id/ivPremiumBadge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#FFD700"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:contentDescription="Premium Badge" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="14sp"
                        android:alpha="0.7"
                        tools:text="username" />

                    <!-- World ID IDKit Liveness Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWorldIdBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#1F06B6D4"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#06B6D4"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌐"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvWorldIdStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="IDKit World ID Verified"
                                android:textColor="#06B6D4"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="14sp"
                        tools:text="This is a short student bio." />
                </LinearLayout>

                <!-- Professional Stats Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/cardBackgroundColor"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/borderStrokeColor"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="16dp"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvLinkersCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/textPrimaryColor"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="0" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Linkers"
                                android:textColor="?attr/textSecondaryColor"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textAllCaps="true" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="?attr/borderStrokeColor"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvProfileUniCoins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/accentColor"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="980" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Coins"
                                android:textColor="?attr/textSecondaryColor"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textAllCaps="true" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="?attr/borderStrokeColor"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvLinkedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/textPrimaryColor"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="12" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Linked"
                                android:textColor="?attr/textSecondaryColor"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textAllCaps="true" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:text="Refine Profile"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:strokeColor="?attr/borderStrokeColor"
                    android:textColor="?attr/textPrimaryColor" />
            </LinearLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUniversityDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/cardBackgroundColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/borderStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="University Details"
                        android:textColor="?attr/accentColor"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvDetail1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="?attr/textPrimaryColor"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_my_calendar"
                        app:drawableTint="?attr/accentColor"
                        android:drawablePadding="16dp"
                        tools:text="SRM University" />

                    <TextView
                        android:id="@+id/tvDetail2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="14sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_info_details"
                        app:drawableTint="?attr/accentColor"
                        android:drawablePadding="16dp"
                        tools:text="AI &amp; Data Science" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="14sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                        app:drawableTint="?attr/accentColor"
                        android:drawablePadding="16dp"
                        tools:text="Chennai, India" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Features & Settings Hub Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeaturesHub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/cardBackgroundColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/borderStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account &amp; Workspace Features"
                        android:textColor="?attr/accentColor"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />

                    <!-- Settings & Themes -->
                    <LinearLayout
                        android:id="@+id/btnSettingsMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            app:tint="?attr/accentColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Settings &amp; Themes"
                                android:textColor="?attr/textPrimaryColor"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dark/Light themes, App Lock &amp; Privacy"
                                android:textColor="?attr/textSecondaryColor"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="?attr/borderStrokeColor"/>

                    <!-- Pro Pass -->
                    <LinearLayout
                        android:id="@+id/btnRedeemPremium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#FFD700" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Newton\'s Lobby Pro Pass 👑"
                                android:textColor="#FACC15"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unlock Incognito, AI Assistant &amp; 2x Rewards"
                                android:textColor="?attr/textSecondaryColor"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="?attr/borderStrokeColor"/>

                    <!-- Resource Vault -->
                    <LinearLayout
                        android:id="@+id/btnVault"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="?attr/accentColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resource Vault 📚"
                                android:textColor="?attr/textPrimaryColor"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shared study notes, papers &amp; project files"
                                android:textColor="?attr/textSecondaryColor"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="?attr/borderStrokeColor"/>

                    <!-- Blocked Users -->
                    <LinearLayout
                        android:id="@+id/btnBlockedUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="?attr/textSecondaryColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Blocked Accounts"
                                android:textColor="?attr/textPrimaryColor"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Manage blocked users"
                                android:textColor="?attr/textSecondaryColor"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions for others -->
            <LinearLayout
                android:id="@+id/llProfileActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLink"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Link UP"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:backgroundTint="?attr/accentColor"
                    app:cornerRadius="14dp"
                    android:textColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantStar"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="6dp"
                    android:text="⭐ Grant Star"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:backgroundTint="#FFD700"
                    app:cornerRadius="14dp"
                    android:textColor="@color/black" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMessage"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Message"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="?attr/borderStrokeColor"
                    app:strokeWidth="1.2dp"
                    android:textColor="?attr/textPrimaryColor"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:text="Sign Out"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="12dp"
                android:alpha="0.8" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Hidden compatibility views -->
    <View android:id="@+id/auraParticles" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tvImpactScore" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/vOnlineStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/rvSkills" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tvUserType" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/btnCustomizePremium" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/cardProfileVisitors" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/rvVisitors" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/rvBadges" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/llSkillsContainer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/btnMore" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
