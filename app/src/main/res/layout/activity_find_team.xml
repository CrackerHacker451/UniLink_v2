<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <com.example.unilink.utils.AuraParticlesView
        android:id="@+id/auraParticles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="?attr/accentColor"
        app:title="Team Discovery"
        app:titleTextColor="?attr/textPrimaryColor"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Glassy Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        style="@style/GlassCard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="?attr/accentColor" />

            <EditText
                android:id="@+id/etSearchTeam"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search projects, skills, stack..."
                android:paddingStart="14dp"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textSecondaryColor"
                android:textSize="15sp"
                android:inputType="text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Categories -->
    <HorizontalScrollView
        android:id="@+id/scrollCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/cardSearch">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/catAiMatch"
                style="@style/QuickActionItem"
                android:background="@drawable/bg_pro_pulse"
                android:text="🤖 Smart Find"
                android:textColor="#FFD700"
                android:stateListAnimator="@animator/btn_press_scale" />

            <TextView
                android:id="@+id/catAll"
                style="@style/QuickActionItem"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tag"
                android:text="All Projects"
                android:stateListAnimator="@animator/btn_press_scale" />

            <TextView
                android:id="@+id/catHackathon"
                style="@style/QuickActionItem"
                android:layout_marginStart="10dp"
                android:text="Hackathons"
                android:stateListAnimator="@animator/btn_press_scale" />

            <TextView
                android:id="@+id/catStartup"
                style="@style/QuickActionItem"
                android:layout_marginStart="10dp"
                android:text="Startups"
                android:stateListAnimator="@animator/btn_press_scale" />

            <TextView
                android:id="@+id/catStudy"
                style="@style/QuickActionItem"
                android:layout_marginStart="10dp"
                android:text="Study Groups"
                android:stateListAnimator="@animator/btn_press_scale" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTeams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/adView"
        app:layout_constraintTop_toBottomOf="@id/scrollCategories" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        app:adSize="BANNER"
        app:adUnitId="@string/banner_ad_unit_id"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:indeterminateTint="?attr/accentColor"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateTeam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_marginBottom="56dp"
        android:stateListAnimator="@animator/btn_press_scale"
        android:text="Launch Team"
        android:textColor="@color/white"
        app:backgroundTint="?attr/accentColor"
        app:icon="@android:drawable/ic_menu_add"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
