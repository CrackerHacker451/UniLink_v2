<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackgroundColor">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/appBackgroundColor"
        app:title="🏆 Hackathons &amp; Events Hub"
        app:titleTextColor="?attr/textPrimaryColor"
        app:subtitle="UPCOMING GLOBAL &amp; CAMPUS HACKATHONS"
        app:subtitleTextColor="?attr/accentColor"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Featured Live Hackathon Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/GlassCard"
                app:cardCornerRadius="20dp"
                app:strokeColor="?attr/accentColor"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴 FEATURED GLOBAL HACKATHON"
                        android:textColor="#EC4899"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="🚀 ETHGlobal Mumbai 2026 ($100,000+ Prizes)"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Build cutting-edge Web3, World ID 4.0, Arkiv DB-Chain &amp; 0G Private Computer ZK AI apps with developers from around the world!"
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🗓️ Nov 20 - 22, 2026 • Mumbai"
                            android:textColor="#F59E0B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRsvpEthGlobal"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Register Team ⚡"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="?attr/accentColor"
                            app:cornerRadius="12dp"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="🔥 UPCOMING HACKATHONS &amp; TECH FESTS"
                android:textColor="?attr/accentColor"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Hackathon 2: UniAI Smart Campus -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/GlassCard"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🤖 UniAI Smart Campus Hackathon (₹50,000 Prizes)"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Develop autonomous AI student assistants, calculus solvers, and handwritten note summarizers."
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🗓️ Registration Open • Online"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRsvpUniai"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="RSVP Now 🚀"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="?attr/accentColor"
                            app:strokeWidth="1dp"
                            android:textColor="?attr/textPrimaryColor"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hackathon 3: Chainlink CRE Global -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/GlassCard"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔗 Chainlink CRE &amp; Web3 Oracles Hackathon"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Build automated cross-chain runtime workflows and verifiable oracle grant settlement smart contracts."
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🗓️ Starts Dec 1, 2026"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRsvpChainlink"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="RSVP Now 🚀"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="?attr/accentColor"
                            app:strokeWidth="1dp"
                            android:textColor="?attr/textPrimaryColor"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
