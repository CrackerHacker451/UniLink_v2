<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="520dp"
    android:background="@drawable/bg_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_shimmer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NewtonAI Personal Agent 🤖"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_help"
            app:tint="?attr/accentColor" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAiChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <!-- Agent Quick Command Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRandomMatch"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="⚡ Random Match"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNearbyRadar"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="📡 Nearby Radar"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStartStream"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🎥 Start Stream"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPostBarter"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="📦 Post Barter"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFindTeam"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="👥 Find Team"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPostDoubt"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🧠 Ask Doubt"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFocusRoom"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="⏳ Focus Room"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLeaderboard"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🏆 Leaderboard"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVaultNotes"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Notes Vault"
                android:textColor="?attr/textPrimaryColor"
                app:chipBackgroundColor="?attr/cardBackgroundColor"
                app:chipStrokeColor="?attr/borderStrokeColor"
                app:chipStrokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/cardBackgroundColor"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/borderStrokeColor"
            app:strokeWidth="1dp">
            <EditText
                android:id="@+id/etAiInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Ask or command NewtonAI (e.g. 'start a stream')..."
                android:paddingHorizontal="16dp"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textSecondaryColor"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAiSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:fabCustomSize="44dp"
            app:backgroundTint="?attr/accentColor"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/white"
            app:elevation="0dp" />
    </LinearLayout>

</LinearLayout>
