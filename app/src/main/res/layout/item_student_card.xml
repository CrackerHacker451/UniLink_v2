<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/GlassCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStudentCardAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:background="@drawable/bg_tag"
                android:padding="2dp" />

            <View
                android:id="@+id/vStudentOnlineGlow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_online_glow"
                android:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStudentCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            tools:text="Student Name" />

        <TextView
            android:id="@+id/tvStudentCardMajor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/accentColor"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            tools:text="COMPUTER SCIENCE" />

        <TextView
            android:id="@+id/tvStudentSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Kotlin • UI/UX • Firebase" />

        <TextView
            android:id="@+id/tvStudentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/accentColor"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="Open to Pair" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:text="View Profile"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/textPrimaryColor"
            app:cornerRadius="20dp"
            android:textColor="?attr/appBackgroundColor"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
