<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="?attr/cardBackgroundColor"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/borderStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:gravity="center_horizontal">

        <!-- Top Badges Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvProBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="PRO"
                android:textColor="#FACC15"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDistanceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="📍 0.8 km"
                android:textColor="?attr/accentColor"
                android:textSize="9sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Avatar Container -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStudentCardAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:background="@drawable/bg_tag"
                android:padding="2dp" />

            <View
                android:id="@+id/vStudentOnlineGlow"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_online_glow"
                android:visibility="visible" />
        </FrameLayout>

        <!-- Name & Major -->
        <TextView
            android:id="@+id/tvStudentCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            tools:text="Aarav Sharma" />

        <TextView
            android:id="@+id/tvStudentCardMajor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/accentColor"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            tools:text="COMPUTER SCIENCE" />

        <!-- Skills -->
        <TextView
            android:id="@+id/tvStudentSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Kotlin • UI/UX • Firebase" />

        <!-- Status Tag -->
        <TextView
            android:id="@+id/tvStudentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="?attr/accentColor"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="Open to Pair" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:text="View Profile"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/accentColor"
            app:cornerRadius="18dp"
            android:textColor="@color/white"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
