<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/GlassCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:backgroundTint="#1AFFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/accentColor"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                tools:text="NOTES" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold"
                android:drawableEnd="@android:drawable/btn_star_big_on"
                android:drawablePadding="6dp"
                app:drawableTint="#FFD700"
                tools:text="20" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            tools:text="DS Algorithms Mastery" />

        <TextView
            android:id="@+id/tvUploader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="12sp"
            tools:text="by Aryan Sharma" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Unlock Premium Access"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="?attr/accentColor"
            app:cornerRadius="26dp"
            android:textColor="@color/bg_dark" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
