<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="10dp"
    app:cardBackgroundColor="?attr/cardBackgroundColor"
    app:cardCornerRadius="28dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/borderStrokeColor"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llPostMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <!-- Author Identity -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPostAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_profile_placeholder"
            app:shapeAppearanceOverlay="@style/CircleImage"
            android:background="@drawable/bg_tag"
            android:padding="1.5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPostAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            app:layout_constraintStart_toEndOf="@id/ivPostAvatar"
            app:layout_constraintTop_toTopOf="@id/ivPostAvatar"
            tools:text="Lalit Mohan" />

        <ImageView
            android:id="@+id/ivPostVipBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/btn_star_big_on"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvPostAuthor"
            app:layout_constraintStart_toEndOf="@id/tvPostAuthor"
            app:layout_constraintTop_toTopOf="@id/tvPostAuthor"
            app:tint="#FACC15" />

        <TextView
            android:id="@+id/tvPostTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:layout_constraintStart_toStartOf="@id/tvPostAuthor"
            app:layout_constraintTop_toBottomOf="@id/tvPostAuthor"
            tools:text="2H AGO" />

        <ImageView
            android:id="@+id/ivPostMenu"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_more"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivPostAvatar"
            app:tint="?attr/textSecondaryColor" />

        <!-- Content -->
        <TextView
            android:id="@+id/tvPostContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivPostAvatar"
            tools:text="Exploring the new Aura Glass UI components for UniLink. The transparency and layering feel so premium!" />

        <!-- Media -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPostImage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPostContent">

            <ImageView
                android:id="@+id/ivPostImage"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_mesh_gradient" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Interaction Bar -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/cvPostImage">

            <!-- Like Pill -->
            <LinearLayout
                android:id="@+id/btnLikeContainer"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_tag"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/btnLike"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="?attr/accentColor" />

                <TextView
                    android:id="@+id/tvPostLikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="1.2k" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llReactionsDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="horizontal" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Comment Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnComment"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="#0DFFFFFF"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="?attr/textSecondaryColor" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="42" />

            <!-- Share Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnShare"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                app:cardBackgroundColor="#0DFFFFFF"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="?attr/textSecondaryColor" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
