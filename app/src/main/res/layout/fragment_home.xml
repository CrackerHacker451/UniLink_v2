<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appBackgroundColor">

        <com.example.unilink.utils.AuraParticlesView
            android:id="@+id/auraParticles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 1:1 Screenshot Matched Top Header Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/homeTopHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <!-- Top Left: Multi-Sparkles Button & UniCoins Badge Side-by-Side -->
                <LinearLayout
                    android:id="@+id/llHeaderLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Sparkles Highlights Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnSparklesHighlights"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="?attr/cardBackgroundColor"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/borderStrokeColor"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="✨"
                            android:textColor="#7CA5B8"
                            android:textSize="18sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- UniCoins Badge Pill (100,175) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHeaderStats"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="?attr/cardBackgroundColor"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/borderStrokeColor"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🪙"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvHeaderUniCoins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="100,175"
                                android:textColor="?attr/textPrimaryColor"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Top Right: Eye Comfort, Notifications Bell, Menu Drawer -->
                <LinearLayout
                    android:id="@+id/llHeaderRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Eye Comfort Sun Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnEyeComfort"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="?attr/cardBackgroundColor"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/borderStrokeColor"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="🔆"
                            android:textColor="#D4B27C"
                            android:textSize="16sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Notifications Bell Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnNotifications"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="?attr/cardBackgroundColor"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/borderStrokeColor"
                        app:strokeWidth="1dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="9dp"
                                android:src="@android:drawable/ic_popup_reminder"
                                app:tint="#9D8EC4"
                                android:contentDescription="Notifications" />
                            <TextView
                                android:id="@+id/tvNotificationCount"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_online_glow"
                                android:visibility="visible" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Menu Drawer Button (≡) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnMenuDrawer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="?attr/cardBackgroundColor"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/borderStrokeColor"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="≡"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Posts Feed -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvActivityFeed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="100dp" />

        </LinearLayout>

    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
