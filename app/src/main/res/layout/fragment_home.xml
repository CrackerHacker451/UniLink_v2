<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appBackgroundColor">

        <com.example.unilink.utils.AuraParticlesView
            android:id="@+id/auraParticles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.6" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_root_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <!-- Header -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvLogoFrame"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardBackgroundColor="?attr/cardBackgroundColor"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="2dp"
                        app:strokeColor="?attr/accentColor"
                        app:strokeWidth="1.5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:id="@+id/ivLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:src="@mipmap/ic_launcher"
                            android:scaleType="centerInside"
                            android:contentDescription="Logo" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/llLogoTextGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/cvLogoFrame"
                        app:layout_constraintEnd_toStartOf="@id/llHeaderActions"
                        app:layout_constraintTop_toTopOf="@id/cvLogoFrame"
                        app:layout_constraintBottom_toBottomOf="@id/cvLogoFrame"
                        app:layout_constraintHorizontal_bias="0.0">

                        <TextView
                            android:id="@+id/tvLogoText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvCollegeName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SRM UNIVERSITY"
                            android:textColor="?attr/accentColor"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llHeaderActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            app:cardBackgroundColor="?attr/cardBackgroundColor"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/borderStrokeColor"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="8dp">
                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@android:drawable/btn_star_big_on"
                                    app:tint="#FFD700"
                                    android:contentDescription="Coins" />
                                <TextView
                                    android:id="@+id/tvHeaderUniCoins"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="100"
                                    android:textColor="?attr/textPrimaryColor"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <FrameLayout
                            android:id="@+id/btnNotifications"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="6dp"
                                android:src="@android:drawable/ic_popup_reminder"
                                app:tint="?attr/textPrimaryColor"
                                android:contentDescription="Notifications" />
                            <TextView
                                android:id="@+id/tvNotificationCount"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_notification_badge"
                                android:gravity="center"
                                android:textColor="@color/white"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <ImageView
                            android:id="@+id/btnLeaderboard"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:padding="6dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#FFD700"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Leaderboard" />

                        <ImageView
                            android:id="@+id/btnSettings"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:padding="6dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            app:tint="?attr/textPrimaryColor"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Settings" />

                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Stories (Temporarily Hidden) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:paddingHorizontal="24dp" />

                <!-- Online Quick Stats Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOnlineCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Students"
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_online_glow" />

                    <TextView
                        android:id="@+id/tvActiveTeamsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Teams"
                        android:textColor="?attr/textSecondaryColor"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_online_glow" />

                    <TextView
                        android:id="@+id/tvNewVaultsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Vaults"
                        android:textColor="?attr/accentColor"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Search Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="?attr/cardBackgroundColor"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/borderStrokeColor"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="?attr/accentColor"
                            android:contentDescription="Search" />

                        <EditText
                            android:id="@+id/etSearchAll"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="Search campus..."
                            android:textColorHint="?attr/textSecondaryColor"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="14sp"
                            android:imeOptions="actionSearch"
                            android:inputType="text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Impact Dashboard Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_premium_card"
                        android:padding="24dp"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tvTotalXp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IMPACT: 0"
                                android:textColor="?attr/textPrimaryColor"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvXpStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="🔥 0-day streak"
                                android:textColor="#FACC15"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <ProgressBar
                            android:id="@+id/progressXp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="16dp"
                            android:progressDrawable="@drawable/bg_streak_progress" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvUniCoins"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100"
                                    android:textColor="?attr/textPrimaryColor"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AVAILABLE UNICOINS"
                                    android:textColor="?attr/textSecondaryColor"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="true" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiAssistant"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="Ask UniAI"
                                android:textAllCaps="false"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:cornerRadius="24dp"
                                app:icon="@android:drawable/ic_menu_help"
                                app:iconTint="@color/white"
                                app:backgroundTint="?attr/accentColor" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Campus Arena Hero Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCampusArena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#A855F7"
                    app:strokeWidth="1.5dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_gradient_card"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡ CAMPUS ARENA &amp; LIVE STAGE"
                                android:textColor="#22D3EE"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="● ARENA LIVE"
                                android:textColor="#10B981"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Fun Activity Hub &amp; Midnight Broadcast 🎙️"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="11:59 Midnight Mic • DareDrop • Barter Block • Roast &amp; Toast"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEnterArena"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="Enter Arena ⚡"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="23dp"
                                app:backgroundTint="#A855F7" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGoLiveStream"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Live 📡"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="23dp"
                                app:strokeColor="#06B6D4"
                                app:strokeWidth="1.5dp"
                                app:backgroundTint="#260F172A"
                                android:textColor="@color/white" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Launchpad Section (Immediately After Campus Arena) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="28dp"
                    android:text="Launchpad"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Quick Actions Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="20dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <include
                        android:id="@+id/actionFindTeam"
                        layout="@layout/item_quick_action_premium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/actionCreateTeam"
                        layout="@layout/item_quick_action_premium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/actionNearby"
                        layout="@layout/item_quick_action_premium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/actionRandomMatch"
                        layout="@layout/item_quick_action_premium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Highlights -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="28dp"
                    android:text="Campus Highlights"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCampusHighlights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="24dp" />

                <!-- Skill Duels -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="28dp"
                    android:text="Skill Duels"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSkillDuels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="20dp" />

                <!-- Focus Zones -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:paddingHorizontal="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus Zones"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvJoinFocusRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Join Room →"
                        android:textColor="?attr/accentColor"
                        android:textStyle="bold" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFocusRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="20dp" />

                <!-- Doubt Board Section (Second Last) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:paddingHorizontal="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doubt Board"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/btnPostDoubt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="+ Post Doubt"
                            android:textColor="?attr/accentColor"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/tvViewAllDoubts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View All"
                            android:textColor="?attr/accentColor"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDoubtBoard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="20dp" />

                <!-- Campus Pulse Section (Last) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:paddingHorizontal="24dp">
                    <TextView
                        android:id="@+id/tvLivePulse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Campus Pulse"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <View
                        android:id="@+id/livePulseBadge"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/tvLivePulse"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_online_glow" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActivityFeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
