<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/cardBackgroundColor"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_tag"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👑 Newton\'s Lobby Pro Pass"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pro_pulse"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="VIP PASS"
            android:textColor="#111B21"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Unlock the ultimate campus operating system experience"
        android:textColor="?attr/textSecondaryColor"
        android:textSize="12sp" />

    <!-- Feature Highlights Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👑 Gold Verified Crown Badge &amp; VIP Profile Ring"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="👻 Incognito / Ghost Mode (Hide from Nearby Radar)"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎨 Cyber Gold, Neon Purple &amp; Aura Dark Liquid Themes"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⚡ 2x UniCoin Multiplier on Dares &amp; Doubt Solves"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🧠 Unlimited AI Genius Tutor Prompts (Gemini 1.5 Flash)"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Plan Choice Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMonthly"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/GlassCard"
            app:strokeColor="#FFD700"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Pass"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$4.99 / mo"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnnual"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/GlassCard"
            app:strokeColor="#10B981"
            app:strokeWidth="2dp"
            app:cardCornerRadius="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Annual Pass (Save 33%)"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$39.99 / yr"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Redeem Promo Code Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etPromoCode"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:hint="Have promo code? (e.g. UNILINKPRO)"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="?attr/textSecondaryColor"
            android:textSize="12sp"
            android:inputType="textCapCharacters" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRedeem"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:text="Redeem 🎟️"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#FFD700"
            android:textColor="#111B21"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Subscribe Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubscribe"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Subscribe to Pro Pass 👑"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#FFD700"
        android:textColor="#111B21"
        app:cornerRadius="26dp" />

</LinearLayout>
