<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 AI Teammate Matchmaker"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="✕"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="4dp" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pairs you with complementary campus skill sets for Hackathons, Startups, and Group Projects."
        android:textColor="?attr/textSecondaryColor"
        android:textSize="12sp" />

    <!-- Scope Selection Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Project Scope:"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipHackathon"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Hackathon 🏆" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStartup"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Startup MVP 🚀" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStudyGroup"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assignment 📚" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Role Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Required Role / Skill Needed:"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTargetSkill"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_tag"
        android:hint="e.g. Figma UI/UX, Kotlin, ML Specialist, Node.js"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="?attr/textSecondaryColor"
        android:textSize="13sp" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRunAiMatch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Find Best Teammates ✨"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:backgroundTint="?attr/accentColor" />

    <!-- Loading Progress -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/matchProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/accentColor" />

    <!-- AI Match Results List -->
    <LinearLayout
        android:id="@+id/llMatchResultsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
