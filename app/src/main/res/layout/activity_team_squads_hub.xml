<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackgroundColor">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/appBackgroundColor"
        app:title="👥 Open Campus Teams"
        app:titleTextColor="?attr/textPrimaryColor"
        app:subtitle="JOIN OPEN SQUADS OR LAUNCH A TEAM"
        app:subtitleTextColor="?attr/accentColor"
        app:navigationIcon="@android:drawable/ic_menu_revert">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateTeamSmall"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:text="+ Create Team"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/accentColor"
            app:cornerRadius="10dp"
            android:textColor="@color/white" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ OPEN TEAMS LOOKING FOR MEMBERS"
            android:textColor="?attr/accentColor"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTeamsHub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

    </LinearLayout>

</LinearLayout>
