<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/llMessageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:background="@drawable/bg_chat_bubble_sent_premium"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:elevation="0dp">

        <!-- Reply Quote -->
        <LinearLayout
            android:id="@+id/llReplyQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#26000000"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">
            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#FFFFFF" />
            <TextView
                android:id="@+id/tvReplyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:text="Message content"
            android:textColor="@color/white"
            android:textSize="14.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEdited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="edited • "
                android:textColor="#B3FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 PM"
                android:textColor="#B3FFFFFF"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/ivStatus"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#B3FFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llReactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_tag"
        android:backgroundTint="?attr/appBackgroundColor"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:visibility="gone" />
</LinearLayout>
