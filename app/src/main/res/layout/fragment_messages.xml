<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversations"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNewChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="31dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/btn_press_scale"
                app:cardBackgroundColor="@color/glass_bg_low"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="?attr/accentColor" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Glassy Search bar -->
        <com.google.android.material.card.MaterialCardView
            style="@style/GlassCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="?attr/textSecondaryColor"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etSearchMessages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/search_chats_hint"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:textColor="?attr/textPrimaryColor"
                    android:textColorHint="?attr/textSecondaryColor"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingBottom="160dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyChats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/no_messages_yet"
        android:textColor="?attr/textSecondaryColor"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
