<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#001F3F"
                android:startColor="#000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.8"
                android:centerY="0.2"
                android:startColor="#4D00E5FF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Add some "sci-fi" lines -->
    <item android:top="10dp" android:bottom="40dp" android:left="20dp" android:right="20dp">
        <shape>
            <stroke android:width="1dp" android:color="#2600E5FF"/>
        </shape>
    </item>
</layer-list>
