rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // HUMAN GATE: only users whose token carries the server-issued `humanVerified` claim.
    function isAuthenticated() {
      return request.auth != null && request.auth.token.get('humanVerified', false) == true;
    }

    // Owners may upload their own profile picture while finishing sign-up (before verification).
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isUnderSize(maxMegabytes) {
      return request.resource.size < maxMegabytes * 1024 * 1024;
    }

    // Default deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User Profile Pictures & Banners (10MB Image Limit)
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImage() && isUnderSize(10);
    }

    // Feed Posts Media (15MB Image Limit)
    match /post_images/{postId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isUnderSize(15);
    }

    // Vault Resource Attachments (50MB PDF/Image Limit)
    match /vault_files/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isPdf() || isImage()) && isUnderSize(50);
    }

    // Chat Attachments (25MB Media Limit)
    match /chat_media/{chatId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isUnderSize(25);
    }
  }
}
